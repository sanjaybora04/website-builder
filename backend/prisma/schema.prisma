generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String
  name         String
  googleOauthId String
  websites     Website[]
  assets       Asset[]
  usedStorage  Int          @default(0) // in bytes
  storageLimit Int          @default(104857600) // e.g., 100 mb
  folders      Folder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Website {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  domain        String        @unique
  googleTag     String?
  favicon       String?
  customCodeForHead String?
  admins        User[]
  draftPages    Json[]
  pages         Json[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  parent    Folder?  @relation("FolderParent", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderParent")
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  assets    Asset[]
  createdAt DateTime @default(now())

  @@unique([userId, parentId, name]) // Prevent duplicate folders in the same path
}

model Asset {
  key         String   @id
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  folderId    String?  @db.Uuid
  folder      Folder?  @relation(fields: [folderId], references: [id])
  filename    String
  size        Int
  contentType String
  createdAt   DateTime @default(now())
}
